# Application
SYNTH_ENVIRONMENT=development
SYNTH_DATABASE_URL=sqlite+pysqlite:///./synthetic_data.db

# Vertex AI authentication uses Application Default Credentials (ADC).
# Do not add API keys or credential JSON files here.
GOOGLE_CLOUD_PROJECT=gd-gcp-gridu-genai
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
SYNTH_GEMINI_MODEL=gemini-2.5-flash

# Optional Langfuse observability. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

